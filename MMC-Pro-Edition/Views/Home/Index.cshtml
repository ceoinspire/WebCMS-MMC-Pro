@using MMC_Pro_Edition.ViewModel
@model PagesViewModel
@{
    ViewData["Title"] = "Home Page";

}


<!-- Main content -->
<!-- Page header -->
<div class="page-header page-header-light">
    <div class="page-header-content header-elements-md-inline">
        <div class="page-title d-flex">
            <h4><i class="icon-arrow-left52 mr-2"></i> <span class="font-weight-semibold">Home</span> - Dashboard</h4>
            <a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
        </div>

        <div class="header-elements d-none">
            <div class="d-flex justify-content-center">
            </div>
        </div>
    </div>

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
                <span class="breadcrumb-item active">Dashboard</span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
        </div>


    </div>
</div>

<div class="content">



    <div class="row">
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body bg-blue-400 has-bg-image">
                <div class="media">
                    <div class="media-body">

                        <h3 class="mb-0">@Model.DashBoardSetting.TotalContent</h3>
                        <span class="text-uppercase font-size-xs">Total Content</span>
                    </div>
                    <a href="/Content/ContentPage" class="text-reset text-decoration-none">
                        <div class="ml-3 align-self-center">
                            <i style="color:white" class="icon-file-text2 icon-3x opacity-75"></i>
                        </div>
                    </a>

                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body bg-danger-400 has-bg-image">
                <div class="media">
                    <div class="media-body">
                        <h3 class="mb-0">@Model.DashBoardSetting.ContentType</h3>
                        <span class="text-uppercase font-size-xs">total ContentType</span>
                    </div>

                    <a href="/Content/GetContentTypes" class="text-reset text-decoration-none">
                        <div class="ml-3 align-self-center">
                            <i style="color:white" class="icon-stack icon-3x opacity-75"></i>
                        </div>
                    </a>

                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body bg-indigo-400 has-bg-image">
                <div class="media">
                    <div class="media-body text-left">
                        <h3 class="mb-0">@Model.DashBoardSetting.ContentCategory</h3>
                        <span class="text-uppercase font-size-xs">Total Categories</span>
                    </div>
                    <a href="/Content/ContentCategory" class="text-reset text-decoration-none">
                        <div class="ml-3 align-self-center">
                            <i style="color:white" class="icon-folder icon-3x opacity-75"></i>
                        </div>
                    </a>


                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body bg-success-400 has-bg-image">
                <div class="media">
                    <div class="media-body text-left">
                        <h3 class="mb-0">@Model.DashBoardSetting.TotalEmails</h3>
                        <span class="text-uppercase font-size-xs">Total Emails</span>
                    </div>
                    <a href="/cmsemails/inbox" class="text-reset text-decoration-none">
                        <div class="ml-3 align-self-center">
                            <i style="color:white" class="icon-mail5 icon-3x opacity-75"></i>
                        </div>
                    </a>

                  
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6 co-xl-3">
			<!-- My messages -->
			<div class="card">
				<div class="card-header header-elements-inline">
					<h6 class="card-title">Recent Content</h6>
					<div class="header-elements">
					</div>
				</div>

				<!-- Numbers -->
				<!-- /numbers -->
				<!-- Area chart -->
				<div id="messages-stats"></div>
				<!-- /area chart -->
				<!-- Tabs -->
				<ul class="nav nav-tabs nav-tabs-solid nav-justified bg-indigo-400 border-x-0 border-bottom-0 border-top-indigo-300 mb-0">
					<li class="nav-item">
						<a href="#messages-tue" class="nav-link font-size-sm text-uppercase active" data-toggle="tab">
							Content
						</a>
					</li>

				</ul>
				<!-- /tabs -->
				<!-- Tabs content -->
				<div class="tab-content card-body">
					<div class="tab-pane active fade show" id="messages-tue">
						<ul class="media-list">

							@foreach (var item in Model.Contents)
							{
								<li class="media">
									<div class="mr-3 position-relative">
										<img src="@item.ImageSource" class="rounded-circle" width="36" height="36" alt="">
									</div>

									<div class="media-body">
										<div class="d-flex justify-content-between">
                                            <a href="Content/EditContent/@item.Id">@item.Name</a>
										</div>

										@item.OtherTitle
									</div>
								</li>
							}
							

							
						</ul>
					</div>

			
				</div>
				<!-- /tabs content -->

			</div>
			<!-- /my messages -->


        </div>
        <div class="col-sm-6 co-xl-3">


        </div>

    </div>

</div>

@section jq {

}